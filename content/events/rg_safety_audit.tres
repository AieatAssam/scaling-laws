[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/event_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "rg_safety_audit"
title = "Snap Safety Audit"
description = "Regulators arrive unannounced with a clipboard and a theory about your alignment team's lunch breaks."
icon = "regulation"
category = "regulation"
weight = 2.0
cooldown = 1800.0
conditions = Array[Dictionary]([{"type": "debt_gte", "value": 6.0}, {"type": "resets_gte", "layer": 4, "value": 1}])
choices = Array[Dictionary]([{"label": "Open the books", "effects": Array[Dictionary]([{"type": "add_debt", "value": -4.0}, {"type": "add_currency", "id": "compute", "value": -10000.0}])}, {"label": "Stall with lawyers", "effects": Array[Dictionary]([{"type": "timed_mod", "key": "compute", "value": 1.1, "seconds": 900.0}, {"type": "add_currency", "id": "equity", "value": -2.0}, {"type": "add_debt", "value": 1.0}])}])
