[ext_resource type="Script" path="res://src/defs/help_topic_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "training"
title = "Training runs"
icon = "training"
order = 30
conditions = Array[Dictionary]([])
hint = "Spending compute on a model, and what the score does."
body = "## What a run does\nYou pick a run type (see the table). It spends a share of your compute at once and runs for its set time.\nWhen it ends, a success scores log10(spend) x your training multiplier x the run's score multiplier, rolled up or down by {SCORE_ROLL:pct}. A failure scores nothing and returns {REFUND_SHARE:pct} of the spend to compute.\nA run needs at least {MIN_TRAIN_SPEND} compute.\n## Your options now\n[training]\n## Fail chance\nEach run type has a base fail chance. Every hired Ops cuts it, down to {FAIL_FLOOR:pct} of the base at most. The chance shown on each run is the composed one.\n## Score and bonuses\nYour best score in this generation multiplies training. Your all-time best adds a smaller bonus that survives resets. Only a score above your best raises it.\n## Energy and data\nOnce a Paradigm Shift is done, each run also uses {TRAIN_ENERGY} energy and {TRAIN_DATA} data."
