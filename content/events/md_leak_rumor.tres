[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/event_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "md_leak_rumor"
title = "Tech Blog Has Questions"
description = "A blogger found your Slack screenshot and wants a comment by Friday. Your intern wants to comment on everything."
icon = "media"
category = "media"
weight = 2.0
cooldown = 1800.0
conditions = Array[Dictionary]([{"type": "time_played_gte", "value": 600.0}])
choices = Array[Dictionary]([{"label": "Say nothing", "effects": Array[Dictionary]([{"type": "timed_mod", "key": "cash", "value": 1.1, "seconds": 600.0}, {"type": "add_debt", "value": 1.0}])}, {"label": "Hold a press call", "effects": Array[Dictionary]([{"type": "add_currency", "id": "equity", "value": -1.0}, {"type": "add_slider", "value": 0.05}])}])
