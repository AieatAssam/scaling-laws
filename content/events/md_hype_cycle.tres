[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/event_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "md_hype_cycle"
title = "The Hype Cycle Arrives"
description = "A columnist calls your lab 'the future, probably'. Investors read it twice, then again at 3am."
icon = "media"
category = "media"
weight = 2.0
cooldown = 1800.0
conditions = Array[Dictionary]([{"type": "resets_gte", "layer": 1, "value": 1}, {"type": "time_played_gte", "value": 1800.0}])
choices = Array[Dictionary]([{"label": "Ride the hype", "effects": Array[Dictionary]([{"type": "add_currency", "id": "equity", "value": 3.0}, {"type": "add_debt", "value": 2.0}])}, {"label": "Under-promise", "effects": Array[Dictionary]([{"type": "add_slider", "value": 0.05}, {"type": "add_currency", "id": "equity", "value": 1.0}])}])
