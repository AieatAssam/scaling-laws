[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/event_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "rg_disclosure"
title = "Compute Disclosure Form"
description = "Regulators want the exact number of GPUs you own. You have a spreadsheet, a hunch and a very tired lawyer."
icon = "regulation"
category = "regulation"
weight = 2.0
cooldown = 1800.0
conditions = Array[Dictionary]([{"type": "resets_gte", "layer": 1, "value": 1}])
choices = Array[Dictionary]([{"label": "File it straight", "effects": Array[Dictionary]([{"type": "add_debt", "value": -2.0}, {"type": "add_currency", "id": "equity", "value": -1.0}])}, {"label": "Round the numbers", "effects": Array[Dictionary]([{"type": "add_currency", "id": "equity", "value": 2.0}, {"type": "add_debt", "value": 3.0}])}])
