[gd_resource type="Resource" script_class="BenchmarkDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/benchmark_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "training_saturation_32"
title = "Benchmark Saturation Event"
description = "Best training score reaches 32. Every test is now trivially solved."
icon = "benchmarks"
badge = "diamond"
conditions = Array[Dictionary]([{"type": "training_best_gte", "value": 32.0}])
effects = Array[Dictionary]([{"type": "perm_mult", "key": "training", "value": 1.03}])
