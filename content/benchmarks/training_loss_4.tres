[gd_resource type="Resource" script_class="BenchmarkDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/benchmark_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "training_loss_4"
title = "Loss Curve, Looking Good"
description = "Best training score reaches 4. The loss curve bends the right way."
icon = "benchmarks"
badge = "silver"
conditions = Array[Dictionary]([{"type": "training_best_gte", "value": 4.0}])
effects = Array[Dictionary]([{"type": "perm_mult", "key": "training", "value": 1.01}])
