[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/event_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "fd_bridge_round"
title = "Bridge Round Knocks"
description = "A bridge round is on the table: quick cash, quicker dilution, and a partner who calls you 'buddy'."
icon = "funding"
category = "funding"
weight = 2.0
cooldown = 1800.0
conditions = Array[Dictionary]([{"type": "resets_gte", "layer": 1, "value": 1}, {"type": "time_played_gte", "value": 1800.0}])
choices = Array[Dictionary]([{"label": "Take the bridge", "effects": Array[Dictionary]([{"type": "add_currency", "id": "equity", "value": 2.0}, {"type": "add_debt", "value": 2.0}])}, {"label": "Wait for a real round", "effects": Array[Dictionary]([{"type": "timed_mod", "key": "cash", "value": 1.1, "seconds": 1200.0}, {"type": "add_currency", "id": "equity", "value": -1.0}])}])
