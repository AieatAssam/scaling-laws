[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/event_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "og_dns_outage"
title = "Global DNS Outage"
description = "A config push takes down your API for six hours. The status page is green, which is somehow worse."
icon = "outage"
category = "outage"
weight = 2.0
cooldown = 1800.0
conditions = Array[Dictionary]([{"type": "resets_gte", "layer": 3, "value": 1}])
choices = Array[Dictionary]([{"label": "Blame the ISP", "effects": Array[Dictionary]([{"type": "add_debt", "value": 2.0}, {"type": "add_currency", "id": "equity", "value": 1.0}])}, {"label": "Public post-mortem", "effects": Array[Dictionary]([{"type": "add_debt", "value": -2.0}, {"type": "add_currency", "id": "equity", "value": -1.0}])}])
