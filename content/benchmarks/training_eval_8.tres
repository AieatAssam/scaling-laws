[gd_resource type="Resource" script_class="BenchmarkDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/benchmark_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "training_eval_8"
title = "Eval Score Ascending"
description = "Best training score reaches 8. The eval is climbing steadily."
icon = "benchmarks"
badge = "gold"
conditions = Array[Dictionary]([{"type": "training_best_gte", "value": 8.0}])
effects = Array[Dictionary]([{"type": "perm_mult", "key": "training", "value": 1.02}])
