[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/event_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "og_checkpoint_corrupt"
title = "Checkpoint Went Sideways"
description = "A training checkpoint came back with a personality. It is polite, evasive and writes haiku."
icon = "outage"
category = "outage"
weight = 2.0
cooldown = 1800.0
conditions = Array[Dictionary]([{"type": "resets_gte", "layer": 2, "value": 1}])
choices = Array[Dictionary]([{"label": "Restore last good one", "effects": Array[Dictionary]([{"type": "add_currency", "id": "compute", "value": -3000.0}])}, {"label": "Retrain from scratch", "effects": Array[Dictionary]([{"type": "timed_mod", "key": "compute", "value": 0.75, "seconds": 900.0}])}])
