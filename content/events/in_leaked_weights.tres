[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/event_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "in_leaked_weights"
title = "Weights On A Forum"
description = "Your model weights are on a message board, labelled 'definitely not the real ones'. They are the real ones."
icon = "incident"
category = "incident"
weight = 2.0
cooldown = 1200.0
conditions = Array[Dictionary]([{"type": "resets_gte", "layer": 1, "value": 1}, {"type": "owned_gte", "id": "server_rack", "value": 1}])
choices = Array[Dictionary]([{"label": "Rotate every key", "effects": Array[Dictionary]([{"type": "add_debt", "value": -1.0}, {"type": "timed_mod", "key": "compute", "value": 0.9, "seconds": 900.0}])}, {"label": "Blame the intern", "effects": Array[Dictionary]([{"type": "add_debt", "value": 2.0}, {"type": "add_currency", "id": "equity", "value": 1.0}])}])
