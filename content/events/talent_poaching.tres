[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/event_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "talent_poaching"
title = "Talent Poaching"
description = "A rival offers your best researcher double."
icon = "poaching"
category = "poaching"
weight = 2.0
cooldown = 1800.0
conditions = Array[Dictionary]([{"type": "staff_gte", "id": "researcher", "value": 1}, {"type": "resets_gte", "layer": 1, "value": 1}])
choices = Array[Dictionary]([{"label": "Match the offer", "effects": Array[Dictionary]([{"type": "add_currency", "id": "equity", "value": -3.0}, {"type": "add_flag", "id": "retained_talent"}])}, {"label": "Let them go", "effects": Array[Dictionary]([{"type": "run_mult", "key": "cash", "value": 1.05}, {"type": "add_currency", "id": "compute", "value": 1000.0}])}])
