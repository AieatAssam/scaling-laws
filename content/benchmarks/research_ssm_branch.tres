[gd_resource type="Resource" script_class="BenchmarkDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/benchmark_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "research_ssm_branch"
title = "State Space Speedrun"
description = "Finish the whole state-space branch. Memory is a solved problem now."
icon = "benchmarks"
badge = "gold"
conditions = Array[Dictionary]([{"type": "research_has", "id": "ssm_base"}, {"type": "research_has", "id": "ssm_state"}, {"type": "research_has", "id": "ssm_long"}, {"type": "research_has", "id": "ssm_scale"}, {"type": "research_has", "id": "ssm_hybrid"}])
effects = Array[Dictionary]([{"type": "perm_mult", "key": "compute", "value": 1.02}])
