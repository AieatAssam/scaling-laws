[ext_resource type="Script" path="res://src/defs/help_topic_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "launches"
title = "Launches"
icon = "breakthroughs"
order = 40
conditions = Array[Dictionary]([{"type": "stat_gte", "id": "trainings", "value": 1}])
hint = "Timed boosts you fire yourself, each with a cooldown."
body = "## What they do
A launch costs a share of cash or compute and gives a timed boost. Only one boost of each kind runs at a time: a new one replaces the old one.
## Cooldowns
Each launch waits out a cooldown before it can fire again. Cooldowns carry across a Funding Round.
## Automation
Auto-launch fires each launch as soon as it is ready and affordable."
