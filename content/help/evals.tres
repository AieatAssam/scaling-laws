[ext_resource type="Script" path="res://src/defs/help_topic_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "evals"
title = "AGI safety evals"
icon = "regulation"
order = 71
conditions = Array[Dictionary]([{"type": "benchmark_unlocked", "id": "reset_paradigm_1"}])
hint = "Clear each AGI stage: full suite, red-team or ship it."
body = "## The three choices\nAGI stages unlock one at a time after the previous stage is cleared. Rate, energy, training and producer requirements use the best values reached since the last Singularity reset. Clear each stage with one of three choices.\n- Full eval suite: 12 hours, pass chance 50% plus 40% of your alignment slider plus 2% per Ops staff, capped at 97%. A failed suite cools down for 1 hour.\n- Community red-team: 6 hours, 70% pass. Each run also speeds rivals up for good.\n- Ship it: instant and certain. It cuts the next stage's numeric requirements by 30% and makes bad alignment and reputation event losses harsher.\n## The ending\nEach cleared stage adds one counter: Assurance (full suite), Openness (red-team) or Recklessness (ship it). The most common method wins: aligned, open-sourced or rushed. A tie goes to the method you chose last.\n## Offline\nEvaluations keep running while you are away, at full speed."
