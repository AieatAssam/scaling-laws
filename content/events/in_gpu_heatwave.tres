[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/defs/event_def.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "in_gpu_heatwave"
title = "Heatwave In The Rack Room"
description = "The cooling loop failed on a Sunday. Someone is toasting marshmallows on the power distribution unit."
icon = "incident"
category = "incident"
weight = 2.0
cooldown = 1200.0
conditions = Array[Dictionary]([{"type": "resets_gte", "layer": 2, "value": 1}, {"type": "owned_gte", "id": "cloud_gpus", "value": 1}])
choices = Array[Dictionary]([{"label": "Run hot anyway", "effects": Array[Dictionary]([{"type": "timed_mod", "key": "compute", "value": 1.2, "seconds": 900.0}, {"type": "add_debt", "value": 3.0}])}, {"label": "Throttle the cluster", "effects": Array[Dictionary]([{"type": "add_currency", "id": "compute", "value": -2000.0}, {"type": "add_slider", "value": 0.05}])}])
